# Normalise line endings so Windows, macOS and Linux checkouts agree.
# Files are stored with LF in the repo; Git converts on checkout as needed.
* text=auto eol=lf

# Binary assets must never be line-ending converted or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary

# Lockfile is generated; keep it out of diffs and merge noise.
pnpm-lock.yaml -diff linguist-generated
