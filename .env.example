# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way: everything below the first section is enough to take money or read the
# whole database.
#
# The rule that decides which prefix a variable gets: NEXT_PUBLIC_ ships the
# value to every visitor's browser. If a value would embarrass you in view
# source, it does not get that prefix.

# ---------------------------------------------------------------------------
# Public. These are in the browser on purpose.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co

# The publishable (anon) key. Safe in the browser ONLY because row level
# security is on every table, which is what it is checked against. Turn RLS off
# on one table and this key reads that table for anyone who views source.
# `node ../backend/scripts/check-rls.mjs` proves it is still on.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=https://offhorizon.com

# Google Tag Manager container, e.g. GTM-XXXXXXX. A container id, not a key.
NEXT_PUBLIC_GTM_ID=

# Termly website id, from the dashboard. Not a secret, but it decides which
# site the consent is recorded against. Blank hides the banner and the cookie
# preferences link rather than showing a control that does nothing.
NEXT_PUBLIC_TERMLY_ID=

# ---------------------------------------------------------------------------
# Server only. No NEXT_PUBLIC_ prefix on anything here, ever.
# ---------------------------------------------------------------------------

# Service role key, from Supabase, Project Settings, API. It bypasses row level
# security completely, so it is the one key that can read every booking and
# every payment. Only lib/supabase/admin.ts touches it, and that file is
# server-only.
SUPABASE_SECRET_KEY=

# Razorpay. The key id is the half the checkout script needs, and the site
# passes it to the browser as a prop from the server rather than by prefix, so
# it stays out of the bundle for pages that do not take payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Signs the webhook body. Without it every webhook is rejected, which is the
# safe direction: nothing confirms a booking except a signed webhook.
RAZORPAY_WEBHOOK_SECRET=

# Shared with the admin panel. Guards /api/revalidate and the overdue job at
# /api/bookings/overdue, so set the same value in both environments.
SITE_REVALIDATE_SECRET=

# Outbound mail: receipts, and the cancellation notice when a balance goes
# unpaid. SMTP_PASSWORD must be an app password, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
